{
	"name": "@uprock-ai/n8n-nodes-uprock",
	"version": "0.5.0",
	"description": "",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "UpRock",
		"email": "developer@uprock.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/uprockcom/n8n-nodes-uprock.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"verify:static": "tsc --noEmit",
		"test:mocked": "node --test tests/*.test.mjs",
		"n8n:local": "./scripts/n8n-local.sh up",
		"n8n:local:detached": "./scripts/n8n-local.sh up-detached",
		"n8n:local:rebuild": "./scripts/n8n-local.sh rebuild",
		"n8n:local:down": "./scripts/n8n-local.sh down",
		"n8n:local:logs": "./scripts/n8n-local.sh logs",
		"release": "./scripts/release-version.sh",
		"release:dry-run": "./scripts/release-version.sh --dry-run",
		"release:minor": "./scripts/release-version.sh minor",
		"release:major": "./scripts/release-version.sh major",
		"release:n8n": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/UpRockCrawlerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/UpRockCrawler/UpRockCrawler.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
